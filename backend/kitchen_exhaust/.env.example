# Kitchen Exhaust Demo WSGI API Configuration Example
# Copy or set these environment variables in your deployment environment.
# DO NOT commit real secrets or credentials to version control.

# SMTP Configuration
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your_secure_smtp_password_here
SMTP_FROM=noreply@kf-software.com
SMTP_TO=requests@kf-software.com
# Security mode: 'starttls', 'ssl' (or 'tls'), or 'none' (local development only)
SMTP_SECURITY=starttls

# Allowed Browser Origins (comma-separated list, no spaces around commas or trimmed automatically)
# In production, set to https://kf-software.com
# For local frontend development, include http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=https://kf-software.com,http://localhost:3000,http://127.0.0.1:3000
